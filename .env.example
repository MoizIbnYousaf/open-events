# Clerk organizer OAuth (optional). Speaker magic links do not use these.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_ORGANIZER_POLICY_CONFIGURED=false
DEPLOY_ENVIRONMENT=local
BUILD_REVISION=local
RESOURCE_D1_ID=local-d1
RESOURCE_R2_NAME=local-r2
# ACCEPTANCE_RESET_SECRET=
CLERK_ORGANIZER_USER_IDS=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Cloudflare's documented localhost-only always-pass test site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Worker-only. Orby uses this on the server; never expose it to Vite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
