{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-events",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://open-events.speakerops.workers.dev",
    "LOCAL_DEV_MODE": "false",
    "ORGANIZER_SESSION_TTL_MS": "7200000",
    "SUBMITTER_SESSION_TTL_MS": "1800000",
    "SUBMITTER_TOKEN_TTL_MS": "86400000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speakerops-production",
      "database_id": "f533e516-efa9-48df-9c83-8342b397c6ca",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "speakerops-production-files",
    },
  ],
}
